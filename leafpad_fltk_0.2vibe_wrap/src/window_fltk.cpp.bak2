/*
 * Leafpad - FLTK based simple text editor
 * Fixed Line Number Widget and Scroll Sync
 */

#include <FL/Fl.H>
#include <FL/Fl_Window.H>
#include <FL/Fl_Menu_Bar.H>
#include <FL/Fl_Text_Buffer.H>
#include <FL/Fl_Text_Display.H>
#include <FL/Fl_Scrollbar.H>
#include <FL/fl_draw.H>
#include <stdio.h>

// Assuming these exist in your project structure
#include "window_fltk.h"
#include "view_fltk.h"
#include "callback_fltk.h"
#include "dialog_fltk.h"
#include "search_dialog.h"

/**
 * LineNumberWidget: 
 * Optimized to draw only visible lines and sync with EditorView
 */
class LineNumberWidget : public Fl_Widget {
    EditorView* editor;
public:
    LineNumberWidget(int x, int y, int w, int h, EditorView* e) : Fl_Widget(x, y, w, h, 0) {
        editor = e;
    }

    void draw() override {
        // Clear background
        fl_push_clip(x(), y(), w(), h());
        fl_color(FL_LIGHT2);
        fl_rectf(x(), y(), w(), h());
        
        // Draw border line
        fl_color(FL_GRAY0);
        fl_line(x() + w() - 1, y(), x() + w() - 1, y() + h());

        if (editor && editor->buffer()) {
            fl_color(FL_DARK3);
            fl_font(editor->textfont(), editor->textsize());
            
            int line_height = editor->textsize() + 2; // Approximate or use fl_height()
            
            // Optimization: Get the range of visible lines
            // count_lines is inclusive and handles the wrap-aware logic
            int top_line = editor->get_top_line_num();
            int total_lines = editor->count_lines(0, editor->buffer()->length(), 1);
            
            // Loop through only the vertical space available
            for (int ly = editor->y(); ly < editor->y() + editor->h(); ly += line_height) {
                // Find what character position is at this Y coordinate
                int char_pos = editor->xy_to_position(editor->x(), ly);
                int line_num = editor->count_lines(0, char_pos, 1);
                
                // Only draw the number once per logical/wrapped line
                // To handle wrapped lines, we check if this line start is visible
                int line_start_pos = editor->buffer()->line_start(char_pos);
                int sx, sy;
                
                if (editor->position_to_xy(line_start_pos, &sx, &sy)) {
                    // Only draw if the line start Y matches our current vertical scanning
                    // This ensures we align with the text precisely
                    char str[12];
                    snprintf(str, sizeof(str), "%d", line_num);
                    
                    // Right-align numbers in the widget
                    int tw = 0, th = 0;
                    fl_measure(str, tw, th, 0);
                    fl_draw(str, x() + w() - tw - 5, sy + (th/2) + 4);
                }
                
                if (line_num >= total_lines && ly > editor->y() + (line_height * 2)) break;
            }
        }
        fl_pop_clip();
    }
};

// Callback to trigger when editor content or scroll position changes
static void editor_sync_cb(int pos, int nInserted, int nDeleted, int nRestyled, const char* deletedText, void* cbArg) {
    MainWindow* win = (MainWindow*)cbArg;
    if (win->line_numbers->visible()) {
        win->line_numbers->redraw();
    }
}

// Custom scrollbar callback to catch active dragging
static void scroll_cb(Fl_Widget* w, void* data) {
    MainWindow* win = (MainWindow*)data;
    // Call the original scrollbar behavior
    ((Fl_Scrollbar*)w)->default_callback(w, NULL);
    // Redraw our line numbers
    if (win->line_numbers->visible()) {
        win->line_numbers->redraw();
    }
}

static void on_options_line_numbers(Fl_Widget* w, void* data) {
    MainWindow* win = (MainWindow*)data;
    if (win->line_numbers->visible()) {
        win->line_numbers->hide();
    } else {
        win->line_numbers->show();
    }
    win->redraw();
}

MainWindow::MainWindow(int w, int h, const char* title) : Fl_Window(w, h, title) {
    current_filename = NULL;
    changed = false;
    line_wrap_enabled = false;

    begin();

    // 1. Setup Editor
    editor = new EditorView(45, 30, w - 45, h - 30, this);
    Fl_Text_Buffer *buff = new Fl_Text_Buffer();
    editor->buffer(buff);
    
    // 2. Setup Line Numbers
    line_numbers = new LineNumberWidget(0, 30, 45, h - 30, editor);
    line_numbers->hide();

    // 3. Attach Callbacks for Sync
    // Trigger on text modification
    buff->add_modify_callback(editor_sync_cb, this);
    
    // Trigger on scrolling (Vertical scrollbar is internal to Fl_Text_Display)
    // We access the protected member or use the public accessor if available
    if (editor->v_scrollbar) {
        editor->v_scrollbar->callback(scroll_cb, this);
    }

    undo_manager = new UndoManager(buff, editor, this);

    // Menu construction
    Fl_Menu_Item menu_items[] = {
        { "&File", 0, 0, 0, FL_SUBMENU },
            { "&New", FL_CTRL + 'n', (Fl_Callback *)on_file_new, this },
            { "&Open...", FL_CTRL + 'o', (Fl_Callback *)on_file_open, this },
            { "&Save", FL_CTRL + 's', (Fl_Callback *)on_file_save, this },
            { "Save &As...", FL_CTRL + FL_SHIFT + 's', (Fl_Callback *)on_file_save_as, this },
            { "&Quit", FL_CTRL + 'q', (Fl_Callback *)on_file_quit, this },
            { 0 },
        { "&Edit", 0, 0, 0, FL_SUBMENU },
            { "Undo", FL_CTRL + 'z', (Fl_Callback *)on_edit_undo, this },
            { "Redo", FL_CTRL + FL_SHIFT + 'z', (Fl_Callback *)on_edit_redo, this },
            { "Cu&t", FL_CTRL + 'x', (Fl_Callback *)on_edit_cut, this },
            { "&Copy", FL_CTRL + 'c', (Fl_Callback *)on_edit_copy, this },
            { "&Paste", FL_CTRL + 'v', (Fl_Callback *)on_edit_paste, this },
            { "Select &All", FL_CTRL + 'a', (Fl_Callback *)on_edit_select_all, this },
            { "&Find...", FL_CTRL + 'f', (Fl_Callback *)on_edit_find, this },
            { 0 },
        { "&Options", 0, 0, 0, FL_SUBMENU },
            { "&Line Wrap", 0, (Fl_Callback *)on_options_line_wrap, this, FL_MENU_TOGGLE },
            { "&Line Numbers", 0, (Fl_Callback *)on_options_line_numbers, this, FL_MENU_TOGGLE },
            { 0 },
        { "&Help", 0, 0, 0, FL_SUBMENU },
            { "&About", 0, (Fl_Callback*)on_about_cb },
            { 0 },
        { 0 }
    };

    Fl_Menu_Bar* menu = new Fl_Menu_Bar(0, 0, w, 30);
    menu->copy(menu_items);

    end();
    resizable(editor);
}
